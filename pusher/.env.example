# Database connection string (MongoDB Atlas or local)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=hushdb"

# Pusher Channels Credentials
PUSHER_APP_ID="your_pusher_app_id"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_public_key"
PUSHER_SECRET="your_pusher_secret"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# Web Push Notification Credentials (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key"

# JSON Web Token Secret (64 hex characters / 256-bit random key)
JWT_SECRET="your_jwt_secret_64_hex_characters"

# Maintenance mode toggle
NEXT_PUBLIC_MAINTENANCE_MODE="false"
